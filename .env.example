# ==========================================
# QUALITASK - VARIABLES DE ENTORNO (EJEMPLO)
# ==========================================

PORT=5000

# Conexión a Base de Datos PostgreSQL (pgAdmin 4)
PGHOST=localhost
PGPORT=5432
PGDATABASE=qualitask_db
PGUSER=postgres
PGPASSWORD=postgres

# Google Identity Services (OAuth 2.0 Real)
VITE_GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com

# Misma audiencia utilizada en Google Identity Services
GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com
# Secreto aleatorio y persistente para conservar sesiones entre reinicios (mínimo 32 caracteres)
SESSION_SECRET=reemplazar_por_un_secreto_aleatorio_de_32_caracteres
